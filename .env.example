# Phakathi Flow environment template
# Copy to .env.local for local development or configure equivalent variables in
# Netlify/Render/Railway/Fly/AWS/Azure. Never commit real secrets.

# APPLICATION

VITE_API_BASE_URL=http://127.0.0.1:4000/api
APP_PUBLIC_URL=http://localhost:5173

NODE_ENV=development
PORT=4000
API_BASE_URL=http://127.0.0.1:4000/api

# DATABASE
# Runtime storage mode:
# local-json = default local .local-data/db.json
# netlify-blobs = hosted Netlify Blobs pilot storage
# postgres = production PostgreSQL via Prisma
PHAKATHI_STORAGE=local-json
DATABASE_URL=postgresql://user:password@localhost:5432/phakathi_flow

# AUTH
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
AUTH_TOKEN_TTL_SECONDS=43200
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_HASH_ITERATIONS=210000

# CORS
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# STORAGE
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# EMAIL
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM=notifications@phakathiholdings.local
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=

# SMS
SMS_PROVIDER_API_KEY=

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MEETING_MODEL=gpt-4.1-mini

# Browser/device push notifications
# Generate persistent keys with: npm run push:vapid
# Keep these stable; changing them can require users to resubscribe their devices.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@phakathiholdings.local

# NETLIFY
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# SCHEDULER
# Use a deployed backend/API URL when Netlify should trigger notification scans
# against persistent backend storage rather than local JSON fallback.
PHAKATHI_API_BASE_URL=
SCHEDULED_NOTIFICATION_SECRET=
ENABLE_LOCAL_NOTIFICATION_SCHEDULER=true

# SAGE
SAGE_API_URL=
SAGE_API_KEY=

# MICROSOFT
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# GOOGLE
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
